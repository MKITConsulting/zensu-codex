{
  "name": "zensu-codex-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime and eval tooling for the zensu-codex plugin. Session Control hooks require Node.js 20; Promptfoo 0.121.20 powers contract and live validation.",
  "scripts": {
    "test": "bash tests/run-all.sh",
    "test:self-check": "bash tests/run-all.sh --self-check",
    "eval": "bash tests/run-all.sh --live",
    "eval:tdd": "cd evals/tdd && npx --no-install promptfoo eval -c promptfooconfig.yaml",
    "eval:session-control": "bash evals/session-control/run-eval.sh contract"
  },
  "devDependencies": {
    "jks-js": "file:evals/stubs/jks-js",
    "promptfoo": "0.121.20"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@hono/node-server": "^2.1.3",
    "@apidevtools/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    },
    "adm-zip": "^0.6.1",
    "fast-uri": "^3.1.9",
    "qs": "6.16.2",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.13.7",
    "ip-address": "^10.7.4",
    "sharp": "^0.35.5",
    "socket.io-parser": "^4.2.7",
    "undici": "^7.30.1",
    "@huggingface/transformers": "^4.3.0",
    "axios": "^1.20.0",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "compression": "^1.8.2",
    "csv-parse": "^7.0.2",
    "engine.io": "^6.6.10",
    "jks-js": "$jks-js",
    "js-yaml@5": "^5.4.2",
    "proxy-addr": "^2.0.8",
    "simple-git": "^4.0.2",
    "basic-ftp": "^6.2.1",
    "@azure/msal-node": "^7.1.0",
    "body-parser": "^2.4.0",
    "follow-redirects": "^1.16.1",
    "zod": "^4.6.6",
    "nunjucks": {
      "chokidar": "^4.0.3"
    }
  }
}
